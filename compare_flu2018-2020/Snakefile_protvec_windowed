RANDOM_SEED = 314159

CLUSTER_MIN_SIZE = 10
CLUSTER_MIN_SAMPLES = 5

METRICS = ["euclidean", "cosine"]
REDUCERS = ["t-sne"]
COMPONENTS = [2]

PROTVEC_WINDOWED_METHODS = [
    f"reduced_{r}_{m}_{c}_protvec_windowed"
    for r in REDUCERS
    for m in METRICS
    for c in COMPONENTS
]

FASTA = "results/translations/alignment_filtered_All.fasta"
PROTVEC_VECTORS = "../data/protVec_100d_3grams.csv"


wildcard_constraints:
    metric = "|".join(METRICS),
    redmethod = "|".join(REDUCERS),
    components = r"\d+",
    method = "|".join(PROTVEC_WINDOWED_METHODS)


rule all:
    input:
        "results/full_HDBSCAN_metadata_protvec_windowed.csv"


rule extract_protvec_pertok:
    input:
        fasta = FASTA,
        vectors = PROTVEC_VECTORS
    output:
        npz = "results/features_pertok_protvec/embeddings.npz"
    conda: "../envs/clustering.yaml"
    shell:
        """
        python ../scripts/extract_protvec_pertok.py \
            --input {input.fasta} \
            --vectors {input.vectors} \
            --output {output.npz}
        """


rule build_protvec_windowed_matrix:
    input:
        npz = "results/features_pertok_protvec/embeddings.npz"
    output:
        matrix = "results/protvec_windowed_distance_matrix_{metric}.csv"
    conda: "../envs/clustering.yaml"
    shell:
        """
        python ../scripts/build_windowed_distance_matrix.py \
            --input {input.npz} \
            --output {output.matrix} \
            --window-size 1 --overlap 0 --sigma 1 \
            --metric {wildcards.metric}
        """


rule reduce_protvec_windowed_matrix:
    input:
        matrix = "results/protvec_windowed_distance_matrix_{metric}.csv"
    output:
        embedding = "results/embed_reduced_{redmethod}_{metric}_{components}_protvec_windowed.csv"
    conda: "../envs/clustering.yaml"
    params:
        random_seed = RANDOM_SEED
    shell:
        """
        python ../scripts/reduce_2d_matrix.py {input.matrix} {wildcards.redmethod} {output.embedding} \
            --n_components {wildcards.components} --random-seed {params.random_seed}
        """


rule cluster_protvec_windowed_with_optimal_parameters:
    input:
        embedding = "results/embed_{method}.csv",
        parameters = "../compare_flu/results/optimal_cluster_accuracy_and_parameters_protvec_windowed.csv",
    output:
        clustered_embedding = "results/cluster_embed_{method}.csv",
        clustered_embedding_figure = "results/cluster_embed_{method}.pdf",
    conda: "../envs/clustering.yaml"
    params:
        min_size = CLUSTER_MIN_SIZE,
        min_samples = CLUSTER_MIN_SAMPLES,
    shell:
        """
        pathogen-cluster \
            --embedding {input.embedding} \
            --label-attribute "{wildcards.method}_label" \
            --min-size {params.min_size} \
            --min-samples {params.min_samples} \
            --distance-threshold "$(csvtk filter2 -f '$method=="{wildcards.method}"' {input.parameters} | csvtk cut -f distance_threshold | csvtk del-header)" \
            --output-dataframe {output.clustered_embedding} \
            --output-figure {output.clustered_embedding_figure}
        """


rule cluster_accuracy_protvec_windowed:
    input:
        metadata = "results/table_of_tips.tsv",
        embedding = "results/cluster_embed_{method}.csv",
    output:
        dataframe = "results/cluster_accuracy_{method}.csv",
    conda: "../envs/clustering.yaml"
    params:
        clade_column = "clade_membership",
        ignored_clusters = ["unassigned", "-1"],
    shell:
        """
        python3 ../scripts/metadata_HDBSCAN.py \
            --method {wildcards.method} \
            --true-clusters {input.metadata} \
            --true-clusters-column {params.clade_column:q} \
            --predicted-clusters {input.embedding} \
            --predicted-clusters-column "{wildcards.method}_label" \
            --ignored-clusters {params.ignored_clusters:q} \
            --output {output.dataframe}
        """


rule concat_cluster_accuracy_protvec_windowed:
    input:
        accuracies = expand(
            "results/cluster_accuracy_{method}.csv",
            method=PROTVEC_WINDOWED_METHODS,
        )
    output:
        metadata = "results/full_HDBSCAN_metadata_protvec_windowed.csv"
    params:
        column = "normalized_vi",
    conda: "../envs/clustering.yaml"
    script: "../scripts/concat_cluster_accuracy.py"
